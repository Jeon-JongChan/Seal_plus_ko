# 새 Android 프로젝트에서 사용하는 기본값입니다. 앱 실행 전 ApplicationId를 지정하세요.
@{
    BuildTask = ':app:assembleDebug'
    TestTask = ':app:testDebugUnitTest'
    ApkDirectory = 'app/build/outputs/apk/debug'
    ApplicationId = ''
    ApiLevel = 35
    BuildToolsVersion = '34.0.0'
    AvdName = 'PortableApi35'
    EmulatorPort = 5556
    AndroidUserDirectory = 'android-user'
    AvdDirectory = 'avd'
    LogDirectory = 'logs'
    TempDirectory = 'tmp'
}
